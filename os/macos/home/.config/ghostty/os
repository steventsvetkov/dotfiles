# macOS Ghostty settings, included from the shared config.

# No title bar and no close/minimize/zoom buttons: AeroSpace manages the windows
# and tmux provides the tabs. (Ghostty tabs still work from the keyboard, but have no tab bar.)
macos-titlebar-style = hidden

# Blur what shows through the transparent background, strong enough that text stays easy to read.
# (On Linux, the compositor does this, e.g. Hyprland on Omarchy.)
background-blur = 250

# Option works as Alt (needed for Alt+C in fzf and word jumps).
macos-option-as-alt = true

# Linux-style terminal shortcuts, the same as Ghostty's defaults on Linux.
# Plain Ctrl+C stays "stop the running program". Cmd is the window manager key (AeroSpace).
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+comma=reload_config

# Quick terminal: a dropdown terminal from anywhere with Cmd+`.
# The first use asks for Accessibility permission in System Settings.
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
